 153          
 154          void UART_Init(void)
 155          {
 156   1          // -------------------------------------------------
 157   1          // UART0: 8-bit, variable baud, 1 stop bit
 158   1          // RX enabled
 159   1          // -------------------------------------------------
 160   1          SCON0 = 0x10; //0x90;
 161   1      
 162   1          // -------------------------------------------------
 163   1          // Timer 1:
 164   1          // Mode 2 = 8-bit auto-reload
 165   1          // Timer 1 clock = SYSCLK
 166   1          // -------------------------------------------------
 167   1      
 168   1          TMOD &= 0x0F;       // ocisti Timer1 konfiguraciju
 169   1          TMOD |= 0x20;       // Timer1 Mode 2
 170   1      
 171   1          CKCON |= 0x08;      // T1M = 1 -> Timer1 clock = SYSCLK
 172   1      
 173   1          // 49 MHz / (2 * 115200) = 212.67
 174   1          // 256 - 213 = 43 = 0x2B
 175   1      
 176   1          TH1 = 0x96; //0x2B;
C51 COMPILER V8.12   CPU_STUP                                                              09/25/2026 15:18:20 PAGE 4   

 177   1          TL1 = 0x96; //0x2B;
 178   1      
 179   1          // -------------------------------------------------
 180   1          // Start Timer 1
 181   1          // -------------------------------------------------
 182   1          TR1 = 1;
 183   1      
 184   1              ES0 = 1;                            // Enable UART0 interrupts
 185   1       
 186   1      }
