  93          void UARTInit (long bdr){
  94   1      
  95   1         SCON0 = 0x10;                       // SCON0: 8-bit variable bit rate
  96   1                                             //        level of STOP bit is ignored
  97   1                                             //        RX enabled
  98   1                                             //        ninth bits are zeros
  99   1                                             //        clear RI0 and TI0 bits
 100   1         if (SYSTEMCLOCK/bdr/2/256 < 1) {
 101   2            TH1 = -(SYSTEMCLOCK/bdr/2);
 102   2            CKCON &= ~0x0B;                  // T1M = 1; SCA1:0 = xx
 103   2            CKCON |=  0x08;
 104   2         } else if (SYSTEMCLOCK/bdr/2/256 < 4) {
 105   2            TH1 = -(SYSTEMCLOCK/bdr/2/4);
 106   2            CKCON &= ~0x0B;                  // T1M = 0; SCA1:0 = 01
 107   2            CKCON |=  0x01;
 108   2         } else if (SYSTEMCLOCK/bdr/2/256 < 12) {
 109   2            TH1 = -(SYSTEMCLOCK/bdr/2/12);
 110   2            CKCON &= ~0x0B;                  // T1M = 0; SCA1:0 = 00
 111   2         } else {
 112   2            TH1 = -(SYSTEMCLOCK/bdr/2/48);
 113   2            CKCON &= ~0x0B;                  // T1M = 0; SCA1:0 = 10
 114   2            CKCON |=  0x02;
