 163          void UART_Init(void)
 164          {
 165   1          // -------------------------------------------------
 166   1          // UART0: 8-bit, variable baud, 1 stop bit
 167   1          // RX enabled
 168   1          // -------------------------------------------------
 169   1          SCON0 = 0x10; //0x90;
 170   1      
 171   1          // -------------------------------------------------
 172   1          // Timer 1:
 173   1          // Mode 2 = 8-bit auto-reload
 174   1          // Timer 1 clock = SYSCLK
 175   1          // -------------------------------------------------
C51 COMPILER V8.12   CPU_STUP                                                              10/02/2026 15:06:53 PAGE 4   

 176   1      
 177   1          TMOD &= 0x0F;       // ocisti Timer1 konfiguraciju
 178   1          TMOD |= 0x20;       // Timer1 Mode 2
 179   1      
 180   1          CKCON |= 0x08;      // T1M = 1 -> Timer1 clock = SYSCLK
 181   1      
 182   1          // 49 MHz / (2 * 115200) = 212.67
 183   1          // 256 - 213 = 43 = 0x2B
 184   1      
 185   1          TH1 = 0x96; //0x2B;
 186   1          TL1 = 0x96; //0x2B;
 187   1      
 188   1          // -------------------------------------------------
 189   1          // Start Timer 1
 190   1          // -------------------------------------------------
 191   1          TR1 = 1;
 192   1      
 193   1              ES0 = 1;                            // Enable UART0 interrupts
 194   1       
 195   1      }
