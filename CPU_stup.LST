 115   2         }
 116   1      
 117   1         TL1 = TH1;                          // init Timer1
 118   1         TMOD &= ~0xf0;                      // TMOD: timer 1 in 8-bit autoreload
 119   1         TMOD |=  0x20;
 120   1         TR1 = 1;                            // START Timer1
 121   1        
 122   1         ES0 = 1;                            // Enable UART0 interrupts
 123   1      }
