  21          void Delay_us(unsigned int us)
  22          {
  23   1              EA = 0;         // disable all interrupts
  24   1          while (us--)
  25   1          {
  26   2                  _nop_();
  27   2                      _nop_();
  28   2                      _nop_();
  29   2                      _nop_();
  30   2                      _nop_();
  31   2                      _nop_();
  32   2                      _nop_();
  33   2                      _nop_();
  34   2                      _nop_();        
  35   2          }
  36   1              EA = 1;         // enable all interrupts
  37   1      }
  38          
  39          void Delay_ms(unsigned int ms)
  40          {
  41   1              unsigned int i; 
  42   1      
  43   1              for (i = 1; i <= ms; i++)  
  44   1                      Delay_us(1000);
  45   1      }
