  70          //----------------------------------------------------------------------------------------------
  71          // Funkcija za slanje komande motornoj ploci preko softverskog UART-a (Tx = P0.3)
  72          // duty_cycle   -       sadrzi podatak o brzini, odnosno procenat "duty cycle"-a;
  73          //
  74          // STx                  -       "softverski" Tx - pin procesora (PORT0-pin3)
  75          //----------------------------------------------------------------------------------------------
  76          
  77          void SendMotorSpeed(unsigned char duty_cycle)
  78          {
  79   1              unsigned char SBUF;                                             // Buffer koji sadrzi bajt kojeg treba poslati  
  80   1              unsigned char i;
  81   1      //      unsigned char k;
  82   1              bit b=0;
  83   1      
  84   1      
  85   1                      SBUF = duty_cycle;                                      // Bajt (procenat brzine) se smesta u buffer za slanje
  86   1      
  87   1                      EA = 0; //EIE2 &= ~1;                           // Zabrana interapta                    (// Zabrana interapta Timer-a br.3, da ne bi se narusilo
             - slanje)
  88   1                      
  89   1                      STx = 0;                                                        // Pocetak slanja - formiranje START bita
  90   1                      Delay_us(7);            ///Delay_us(55);        
  91   1      
  92   1              
  93   1                      for (i=0; i<8; i++)                                     // Slanje bitova ponaosob
  94   1                      {
  95   2                              if ((SBUF & 0x01) == 0x01)              // Izdvajanje LSB-a, koji ce biti poslat u ovoj iteraciji 
  96   2                                      b = 1;                                          // b = vrednost LSB-a
  97   2                              else 
  98   2                                      b = 0;
  99   2      
 100   2                              SBUF = SBUF >> 1;                               // Priprema za izdvajanje sledeceg LSB-a za slanje
 101   2              
 102   2                              STx = b;                                                // Slanje prethodno izdvojenog bita
 103   2                              Delay_us(7);    
 104   2                      }
 105   1      
 106   1                      STx = 1;                                                        // Zavrsetak slanje - formiranje STOP bita
 107   1                      Delay_us(20);           
 108   1      
 109   1                      EA = 1; //EIE2 |= 1;                            // Vracanje dozvole inerapta            (// Vracanje dozvole inerapta od Timer-a br.3)
 110   1      
 111   1      
 112   1      }
