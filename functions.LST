  68          //----------------------------------------------------------------------------------------------
  69          // Funkcija za slanje komande motornoj ploci preko softverskog UART-a (Tx = P0.3)
  70          // duty_cycle   -       sadrzi podatak o brzini, odnosno procenat "duty cycle"-a;
  71          //
  72          // STx                  -       "softverski" Tx - pin procesora (PORT0-pin3)
  73          //----------------------------------------------------------------------------------------------
  74          
  75          void SendMotorSpeed(unsigned char duty_cycle)
  76          {
  77   1              unsigned char SBUF;                                             // Buffer koji sadrzi bajt kojeg treba poslati  
  78   1              unsigned char i;
  79   1      //      unsigned char k;
  80   1              bit b=0;
  81   1      
  82   1      
  83   1                      SBUF = duty_cycle;                                      // Bajt (procenat brzine) se smesta u buffer za slanje
  84   1      
  85   1                      EA = 0; //EIE2 &= ~1;                           // Zabrana interapta                    (// Zabrana interapta Timer-a br.3, da ne bi se narusilo
             - slanje)
  86   1                      
  87   1                      STx = 0;                                                        // Pocetak slanja - formiranje START bita
  88   1                      Delay_us(7);            ///Delay_us(55);        
  89   1      
  90   1              
  91   1                      for (i=0; i<8; i++)                                     // Slanje bitova ponaosob
  92   1                      {
  93   2                              if ((SBUF & 0x01) == 0x01)              // Izdvajanje LSB-a, koji ce biti poslat u ovoj iteraciji 
  94   2                                      b = 1;                                          // b = vrednost LSB-a
  95   2                              else 
  96   2                                      b = 0;
  97   2      
  98   2                              SBUF = SBUF >> 1;                               // Priprema za izdvajanje sledeceg LSB-a za slanje
  99   2              
 100   2                              STx = b;                                                // Slanje prethodno izdvojenog bita
 101   2                              Delay_us(7);    
 102   2                      }
 103   1      
 104   1                      STx = 1;                                                        // Zavrsetak slanje - formiranje STOP bita
 105   1                      Delay_us(20);           
 106   1      
 107   1                      EA = 1; //EIE2 |= 1;                            // Vracanje dozvole inerapta            (// Vracanje dozvole inerapta od Timer-a br.3)
 108   1      
 109   1      
 110   1      }
