  21          void Delay_us(unsigned int us)
  22          {
  23   1              EA = 0;         // disable all interrupts
  24   1          while (us--)
  25   1          {
  26   2                  _nop_();
  27   2                      _nop_();
  28   2                      _nop_();
  29   2                      _nop_();
  30   2                      _nop_();
  31   2                      _nop_();
  32   2                      _nop_();
  33   2                      _nop_();
  34   2                      _nop_();        
  35   2          }
  36   1              EA = 1;         // enable all interrupts
  37   1      }
  38          
