void UART_Init(void)
{
    // -------------------------------------------------
    // UART0: 8-bit, variable baud, 1 stop bit
    // RX enabled
    // -------------------------------------------------
    SCON0 = 0x10; //0x90;

    // -------------------------------------------------
    // Timer 1:
    // Mode 2 = 8-bit auto-reload
    // Timer 1 clock = SYSCLK
    // -------------------------------------------------

    TMOD &= 0x0F;       // ocisti Timer1 konfiguraciju
    TMOD |= 0x20;       // Timer1 Mode 2

    CKCON |= 0x08;      // T1M = 1 -> Timer1 clock = SYSCLK

    // 49 MHz / (2 * 115200) = 212.67
    // 256 - 213 = 43 = 0x2B

    TH1 = 0x96; //0x2B;
    TL1 = 0x96; //0x2B;

    // -------------------------------------------------
    // Start Timer 1
    // -------------------------------------------------
    TR1 = 1;

	ES0 = 1;                            // Enable UART0 interrupts
 
}


