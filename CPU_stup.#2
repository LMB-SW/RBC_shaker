void OscInit(void){
int  i;

	OSCICN = 0x80;    // interni osc -> 24.5MHz
	CLKSEL = 0x00;    
	OSCICN = 0x83;	  // max SYSCLK
		CLKMUL = 0x00;    
		CLKMUL |= 0x80;   // multiple sa 2
		for(i = 0; i < 200; i++);
		CLKMUL |= 0xC0; 
		while(!(CLKMUL & 0x20));
	VDM0CN = 0x80;    
	RSTSRC = 0x06;    
	CLKSEL = 0x00;	
}

