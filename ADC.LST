  63          long ADC_Filter(long new_value)
  64          {
  65   1          static long filtered = 0;
  66   1          static bit first = 1;
  67   1      
  68   1          if (first)
  69   1          {
  70   2              filtered = new_value;
  71   2              first = 0;
  72   2          }
  73   1          else
  74   1          {
  75   2              filtered = filtered + (new_value - filtered) / FiltDivisor;     // delilac je bio 8
  76   2      
  77   2      //              if (filtered - new_value < (X1 - X0) / 10)
  78   2      //                      filtered = X0;
  79   2          }
  80   1      
  81   1          return filtered;
  82   1      }
