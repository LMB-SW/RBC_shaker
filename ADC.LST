  67          long ADC_Filter(long new_value)
  68          {
  69   1          static long filtered = 0;
  70   1          static bit first = 1;
  71   1      
  72   1          if (first)
  73   1          {
  74   2              filtered = new_value;
  75   2              first = 0;
  76   2          }
  77   1          else
  78   1          {
  79   2              filtered = filtered + (new_value - filtered) / FiltDivisor;     // delilac je bio 8
  80   2      
  81   2      //              if (filtered - new_value < (X1 - X0) / 10)
  82   2      //                      filtered = X0;
  83   2          }
  84   1      
  85   1          return filtered;
  86   1      }
