 559          void ADCLoop(void)
 560          {
 561   1        
 562   1              if(!ADC_canrun) return; 
 563   1      
 564   1              
 565   1              GetADCvalue();
 566   1                              
 567   1                                              
 568   1              if(Wght_Meas_canrun)            
 569   1              {
 570   2                      if(ADC_avg <= X0)
 571   2                      {
 572   3                              Wght = 0;       
 573   3      
 574   3                      }               
 575   2                      else
 576   2                      {
 577   3                              Wght = (REF_value * (ADC_avg- X0)) / (X1-X0);
 578   3      
 579   3                              if(Wght > 999)
 580   3                                      Wght = 999;
 581   3                      }
 582   2              }
 583   1                                              
 584   1      }
