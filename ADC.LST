  56          long ADC_Filter(long new_value)
  57          {
  58   1          static long filtered = 0;
  59   1          static bit first = 1;
  60   1      
  61   1          if (first)
  62   1          {
  63   2              filtered = new_value;
  64   2              first = 0;
  65   2          }
  66   1          else
  67   1          {
  68   2              filtered = filtered + (new_value - filtered) / FiltDivisor;     // delilac je bio 8
  69   2          }
  70   1      
  71   1          return filtered;
  72   1      }
