#include "CPU_setup.h"
#include "shaker.h"


unsigned char ShakingTime = 0;
unsigned char Shaking_ActivePeriod = 0;
unsigned char Shaking_PausePeriod  = 0;
unsigned char Shaking_ActiveCnt    = 0;
unsigned char Shaking_PauseCnt     = 0;

extern bit DPoint;
extern bit Show_Weight;
extern bit Show_Time;
extern bit Show_Error;
extern unsigned long Wght;
extern unsigned long REF_value;

bit Shaker_Run = 0;
bit PauseMode  = 0;

ShakStat ShakerStatus = IDLE;


void ShakerLoop(void)
{
	if (ShakerStatus == IDLE  &&  Shaker_Run)
	{
		STx = 0;			// run shaker motor
		Show_Time = 1;		// show shaking time on display
		Show_Weight = 0;
		Shaker_Run = 0;
		if(PauseMode)
			Shaking_ActiveCnt = Shaking_ActivePeriod;
		//Shaking_PauseCnt  = Shaking_PausePeriod;

		ShakerStatus = RUNNING;
	}

	else if (ShakerStatus == RUNNING  &&  PauseMode  &&  Shaking_ActiveCnt == 0)
	{
		STx = 1;			// stop shaker motor
		Shaking_PauseCnt  = Shaking_PausePeriod;

		ShakerStatus = PAUSE;
	}

	else if (ShakerStatus == PAUSE  &&  Shaking_PauseCnt == 0)
	{
		STx = 0;			// run shaker motor
		Shaking_ActiveCnt = Shaking_ActivePeriod;

		ShakerStatus = RUNNING;
	}

	else if ((ShakerStatus == RUNNING  ||  ShakerStatus == PAUSE)  &&  ShakingTime == 0)
	{
		STx = 1;			// stop shaker motor
		Show_Time = 0;		
		Show_Weight = 1;	// show weight on display
		DPoint = 0;

		ShakerStatus = FINISHED;
	}

	else if (ShakerStatus == RUNNING  &&  Wght < BAG_WEIGHT_THRESHOLD * REF_value)		// ovde je bilo  0.2*REF_value
	{
		STx = 1;			// stop shaker motor
		Show_Error = 1;

		ShakerStatus = ERROR;
	}
	else if (ShakerStatus == ERROR  &&  Wght > BAG_WEIGHT_THRESHOLD * REF_value)		// ovde je bilo  0.9*REF_value
	{
		STx = 0;			// run shaker motor
		Show_Error = 0;

		ShakerStatus = RUNNING;
	}

	else if (ShakerStatus == FINISHED  &&  Wght < BAG_WEIGHT_THRESHOLD * REF_value)	// ovde je bilo  0.2*REF_value
	{	
		ShakerStatus = IDLE;
	}


}