unsigned char SetBoardAddress(void)
{
	if(Jumper == 0)		//postoji jumper na plocici, spaja pin na GND
		return 0x34;
	else				//ne postoji jumper na plocici, spaja pin na Vmcu
		return 0x33;	
}

