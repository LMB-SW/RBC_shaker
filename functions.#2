void Delay_us(unsigned int us)
{
	EA = 0;		// disable all interrupts
    while (us--)
    {
	    _nop_();
		_nop_();
		_nop_();
		_nop_();
		_nop_();
		_nop_();
		_nop_();
		_nop_();
		_nop_();	
    }
	EA = 1;		// enable all interrupts
}

void Delay_ms(unsigned int ms)
{
	unsigned int i;	

	for (i = 1; i <= ms; i++)  
		Delay_us(1000);
}

void putc0(unsigned char dat)
{
		
  	SBUF0= dat;
	sendByteDelay = 2;
  	while ((SCON0&0x02)==0  && sendByteDelay){}
  	SCON0 &= 0xfd; 	
}

