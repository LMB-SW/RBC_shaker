#include "CPU_setup.h"
#include "display.h"
#include "communication.h"
#include "shaker.h"


#define TIMER2_PERIOD	1	// 1ms

bit MessageArriving = 0;

extern bit MessageReceived;
extern unsigned char BoardAddress;

extern bit DPoint;
extern bit ADC_canrun;

extern bit Show_Error;
extern bit Show_Error_Page;


xdata unsigned char ComData[UART0_BUFFER_SIZE];
unsigned int CntRX0 = 0;

extern unsigned char ShakingTime;
extern unsigned char Shaking_ActiveCnt;
extern unsigned char Shaking_PauseCnt;

unsigned char sendByteDelay = 0;

unsigned char Hundred_ms = 100 * TIMER2_PERIOD;	// 100counts x 1ms = 100ms
unsigned int OneSecond = 1000 * TIMER2_PERIOD;		// 1000counts x 1ms = 1s
unsigned int OneMin = 60000 * TIMER2_PERIOD;		// 60000counts x 1ms = 1min

unsigned char disp_cnt = DISPLAY_REFRESH_PERID - 1;
bit disp_show_flag = 0;

	unsigned char ADCsemp = 10;		// bilo je 10
	unsigned char ADCcnt = 10;		// bilo je 10

	unsigned char ErrShowTimeCnt = 0;

	extern bit ADC_Loop_Start;

	extern ShakStat ShakerStatus;


/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

void Timer2_ISR(void) interrupt 5{			// na 1ms (PROVERITI !!!  --  jeste na 1ms, provereno osciloskopom)

//	static unsigned char shaking_Active;
//	static unsigned char shaking_Pause;

	TF2H = 0;         /* clear Timer2 interrupt flag */

//	shaking_Active = Shaking_ActivePeriod;
//	shaking_Pause = Shaking_PausePeriod;


	//////////////////// on every 1 ms ///////////////////////

	if(disp_cnt)
		disp_cnt--;
	else
	{
		disp_cnt = DISPLAY_REFRESH_PERID - 1;

		disp_show_flag = 1;

	}

			if(ADCcnt  &&  ADC_canrun)
				ADCcnt--;
			else
			{
				ADCcnt = ADCsemp;
				ADC_Loop_Start = 1;		//PRIVREMENO, ZA TEST
			}
	//////////////////////////////////////////////////////////

	//////////////////// on every 100 ms /////////////////////

	if(Hundred_ms)
		Hundred_ms--;
	else
	{
		Hundred_ms = 100 * TIMER2_PERIOD;


		if(sendByteDelay)
			sendByteDelay--;


		if(Show_Error)
		{
			ErrShowTimeCnt++;
			if(ErrShowTimeCnt==3)
			{
				Show_Error_Page = !Show_Error_Page;
				ErrShowTimeCnt = 0;
			}
		}

	}
	//////////////////////////////////////////////////////////

	//////////////////// on every 1 s ////////////////////////

	if(OneSecond)
		OneSecond--;
	else
	{
		OneSecond = 1000 * TIMER2_PERIOD;
		
		///P1 = ~P1;
/*
		if(ShakingTime  &&  ShakerStatus == RUNNING)
		{
			ShakingTime--;
			DPoint = !DPoint;	///DPoint = ~DPoint;
		}
*/
		if(ShakingTime  &&  ShakerStatus != ERROR)
		{
			if(Shaking_ActiveCnt)
			{
				Shaking_ActiveCnt--;
				ShakingTime--;
			}
			else if(Shaking_PauseCnt)
			{
				Shaking_PauseCnt--;
			}

			DPoint = !DPoint;
		}

	}

	//////////////////////////////////////////////////////////

}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

void Uart0_ISR(void) interrupt 4{  

	if(RI0 && !MessageReceived)		//Receiving
	{
		ComData[CntRX0] = SBUF0;				//Iz registra UART-a osmobitni podatak se smesta u elemente niza ComData		

		
		if(CntRX0 == 0  &&  ComData[CntRX0] == START)
			CntRX0++;
			
		else if(CntRX0 == 1  &&  ComData[CntRX0] == BoardAddress)
		{
			CntRX0++;
			MessageArriving = 1;
		}

		else if(MessageArriving)
		{
			CntRX0++;

			if(CntRX0 >= MESSAGE_SIZE)
			{
				MessageReceived = 1;
				MessageArriving = 0;

				CntRX0 = 0;
			}	
		}
	}
	
	RI0 = 0;

		
	if(TI0)		//Transmitting
	{
		
		TI0 = 0;	
	}

}

